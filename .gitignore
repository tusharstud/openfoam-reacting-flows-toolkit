# OpenFOAM Time Directories (ignore generated non-zero time directories inside cases and benchmarks)
cases/*/[1-9]*/
cases/*/[0-9]*.[0-9]*/
!cases/*/0/
!cases/*/0.orig/
benchmarks/*/[1-9]*/
benchmarks/*/[0-9]*.[0-9]*/
!benchmarks/*/0/
!benchmarks/*/0.orig/

# Parallel decomposition folders
**/processor*

# Meshing & Geometry generated files (keep dictionaries)
**/polyMesh/points
**/polyMesh/faces
**/polyMesh/owner
**/polyMesh/neighbour
**/polyMesh/boundary
**/polyMesh/pointZones
**/polyMesh/faceZones
**/polyMesh/cellZones

# OpenFOAM logs & temporary files
**/log.*
**/PyFoam*
**/*.foam
**/*.OpenFOAM
**/*.vtk

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env/
*.egg-info/
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
