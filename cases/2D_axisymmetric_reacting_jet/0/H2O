FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      H2O;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    fuelInlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    coflowInlet
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.0;
        value           uniform 0.0;
    }

    axis
    {
        type            symmetryPlane;
    }

    outerWall
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

