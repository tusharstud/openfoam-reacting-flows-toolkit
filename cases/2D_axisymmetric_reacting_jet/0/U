FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fuelInlet
    {
        type            fixedValue;
        value           uniform (0 35.0 0); // Core fuel jet velocity 35 m/s
    }

    coflowInlet
    {
        type            fixedValue;
        value           uniform (0 1.2 0);  // Low-speed oxidizer coflow 1.2 m/s
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    axis
    {
        type            symmetryPlane;
    }

    outerWall
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}

